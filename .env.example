# Copy to .env and edit as needed. See server/main.py for how these are used.
# In Azure, these same secrets live in Key Vault (brewline-kv) and are wired
# into the backend/mcp container apps as keyvaultref secrets resolved via
# each app's system-assigned managed identity -- see scripts/deploy_mcp.sh.
# This plaintext .env file is for local dev only.

BREWLINE_ARRIVAL_RATE=0.5
BREWLINE_NUM_BARISTAS=2
BREWLINE_MEAN_SERVICE_TIME=3.0
BREWLINE_HORIZON=480.0
BREWLINE_REPS=50
BREWLINE_SEED=42

# Azure OpenAI (gpt-4o), used by the /api/assistant endpoint via the openai
# SDK's v1-compatible API. Leave blank to disable the endpoint (it returns
# 503 until all three are set).
# ENDPOINT is the resource's v1 base URL: https://<resource>.openai.azure.com/openai/v1
# MODEL is the deployment name (e.g. "gpt-4o").
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=

# Voyage AI, used to embed both the search index and incoming questions.
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Azure AI Search (small RAG demo over the most recently generated
# brewline_results.json). Runs automatically whenever BrewLine.py's CLI
# writes a results file, once VOYAGE_API_KEY above is also set.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=brewline-docs
# Must match the embedding model's output dimension (1024 for voyage-3;
# change if using a different Voyage model).
AZURE_SEARCH_VECTOR_DIMENSIONS=1024

# Azure SQL Database. BrewLine.py's CLI writes each run's config + KPI
# summary here automatically (creating the runs/run_kpis/
# run_barista_utilization tables on first use); the MCP server also exposes
# it read-only via list_tables/run_query. Auth is Microsoft Entra ID only
# (no SQL login exists) -- resolves via the logged-in `az` CLI session
# locally.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=

# mcp_server.py's transport. "stdio" (default) is for local MCP clients like
# Claude Code (see .mcp.json) and isn't reachable over the network. Set to
# "streamable-http" to run it as an HTTP server instead -- required for
# docker-compose's `mcp` service, and for server/main.py's /api/assistant to
# reach it via MCP_SERVER_URL below.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Shared secret required as `Authorization: Bearer <token>` by the HTTP
# transport. Required in practice whenever MCP_HOST is reachable from
# outside localhost -- query_sql otherwise lets anyone who can reach the
# port run arbitrary read-only SELECTs against the database. Generate with
# e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# Application Insights, for request/dependency/exception telemetry from
# server/main.py and mcp_server.py. Leave blank to skip telemetry entirely
# (e.g. local dev). Get the value with:
#   az monitor app-insights component show -g brewline-rg -a <name> \
#     --query connectionString -o tsv
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Where server/main.py's /api/assistant reaches the MCP server above to give
# gpt-4o tool-calling access to historic runs (query_sql, list_sql_tables,
# read_results, summarize_results) when answering visitor questions. Under
# docker-compose this is http://mcp:8765/mcp (the `mcp` service on the
# compose network); leave blank to disable (falls back to RAG/live-context
# only, as before). Must match MCP_AUTH_TOKEN above.
MCP_SERVER_URL=
